pw    pw    pw    pw    pw    pw    pw    pw    pw    pw    pw    pw    pw    pw    pw    pw    pw

% ===================== GEOMETRY CELLS =====================
surf sCB1  cyl 0.0 0.0 187.96     % core barrel inner
surf sCB2  cyl 0.0 0.0 193.675    % core barrel outer
surf sLin  cyl 0.0 0.0 219.150    % RPV liner inner
surf sRPVi cyl 0.0 0.0 219.710    % RPV inner
surf sRPVo cyl 0.0 0.0 241.3      % RPV outer
surf zb    pz 0.0                 % active fuel bottom
surf zt    pz 365.76              % active fuel top
surf zrb   pz -30.0               % reflector bottom
surf zrt   pz 395.76              % reflector top

cell cCore   0 fill core    -sCB1 zb -zt
cell cRefB   0 water        -sCB1 zrb -zb
cell cRefT   0 water        -sCB1 zt -zrt
cell cBarrel 0 ss304         sCB1 -sCB2 zrb -zrt
cell cDown   0 water         sCB2 -sLin zrb -zrt
cell cLiner  0 ss304         sLin -sRPVi zrb -zrt
cell cRPV    0 carbonsteel   sRPVi -sRPVo zrb -zrt
cell cOut    0 outside       sRPVo
cell cOutB   0 outside      -sRPVo -zrb
cell cOutT   0 outside      -sRPVo zrt

% ===================== RUN SETTINGS =====================
set pop 20000 250 50      % neutrons/cycle, active, inactive
set bc 1                  % vacuum (black) outer boundary
% set acelib "/path/to/jeff311.xsdir"   % <- set your library (600 K suffix)
set ures 1
